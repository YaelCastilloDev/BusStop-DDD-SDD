{
  "realm": "auth-demo",
  "displayName": "BusStop Authentication Realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "RegisteredUser",
        "description": "Can register routes, add comments, react to comments",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "Curator",
        "description": "RegisteredUser permissions + soft-delete routes, comments, users",
        "composite": true,
        "composites": {
          "realm": ["RegisteredUser"]
        },
        "clientRole": false
      },
      {
        "name": "SubAdmin",
        "description": "Curator permissions + approve/deny soft-delete requests + promote/demote User to Curator",
        "composite": true,
        "composites": {
          "realm": ["Curator"]
        },
        "clientRole": false
      },
      {
        "name": "Admin",
        "description": "SubAdmin permissions + assign/manage SubAdmin role",
        "composite": true,
        "composites": {
          "realm": ["SubAdmin"]
        },
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "busstop-api",
      "name": "BusStop API",
      "description": "The main BusStop ASP.NET API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "CHANGE-ME-IN-PRODUCTION",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "implicitFlowEnabled": false,
      "bearerOnly": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:5000/*",
        "https://localhost:5001/*"
      ],
      "webOrigins": [
        "http://localhost:5000",
        "https://localhost:5001"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "user.attribute": "realm_roles",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "clientId": "busstop-swagger",
      "name": "BusStop Swagger UI",
      "description": "Swagger UI for interactive API documentation",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "bearerOnly": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:57679/swagger/oauth2-redirect.html",
        "https://localhost:57679/swagger/oauth2-redirect.html",
        "http://localhost:5000/swagger/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:57679",
        "https://localhost:57679",
        "http://localhost:5000"
      ]
    }
  ],
  "users": [
    {
      "username": "registered1",
      "enabled": true,
      "email": "registered1@example.com",
      "firstName": "Registered",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["RegisteredUser"]
    },
    {
      "username": "curator1",
      "enabled": true,
      "email": "curator1@example.com",
      "firstName": "Curator",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["Curator"]
    },
    {
      "username": "subadmin1",
      "enabled": true,
      "email": "subadmin1@example.com",
      "firstName": "SubAdmin",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["SubAdmin"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@example.com",
      "firstName": "Admin",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["Admin"]
    }
  ]
}
